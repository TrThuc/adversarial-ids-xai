{
  "experiment": {
    "name": "lstm_baseline_a2",
    "seed": 42,
    "auto_resume": false
  },
  "data": {
    "input_size": 42,
    "num_classes": 10,
    "test_size": 0.20,
    "validation_ratio": 0.10,
    "random_state": 42
  },
  "model": {
    "type": "LSTM",
    "hidden_size": 64,
    "num_layers": 1,
    "dropout": 0.3
  },
  "training": {
    "batch_size": 64,
    "epochs": 10,
    "learning_rate": 0.0007,
    "weight_decay": 0.0,
    "num_workers": 0,
    "optimizer": "Adam"
  },
  "checkpoint": {
    "save_best": true,
    "save_last": true,
    "monitor": "accuracy",
    "mode": "max"
  }
}